{
  "name": "gotcha",
  "private": true,
  "workspaces": [
    "services/api",
    "services/worker",
    "apps/admin",
    "apps/web",
    "apps/web-learner",
    "packages/shared"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=services/api",
    "dev:api:stable": "npm run dev:stable --workspace=services/api",
    "dev:worker": "npm run dev --workspace=services/worker",
    "dev:admin": "npm run dev --workspace=apps/admin",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:web-learner": "npm run dev --workspace=apps/web-learner",
    "build": "npm run build --workspaces --if-present",
    "db:migrate": "npm run db:migrate --workspace=services/api",
    "db:seed": "npm run db:seed --workspace=services/api",
    "db:generate": "npm run db:generate --workspace=services/api"
  },
  "engines": {
    "node": ">=20"
  }
}
