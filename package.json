{
  "name": "gotcha",
  "private": true,
  "workspaces": [
    "packages/shared",
    "services/api",
    "services/worker",
    "apps/admin",
    "apps/web",
    "apps/web-learner"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=services/api",
    "dev:api:stable": "npm run dev:stable --workspace=services/api",
    "dev:worker": "npm run dev --workspace=services/worker",
    "dev:admin": "npm run dev --workspace=apps/admin",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:web-learner": "npm run dev --workspace=apps/web-learner",
    "build": "npm run build -w packages/shared && npm run build --workspaces --if-present -w services/api -w services/worker -w apps/admin -w apps/web -w apps/web-learner",
    "db:migrate": "npm run db:migrate --workspace=services/api",
    "db:seed": "npm run db:seed --workspace=services/api",
    "db:generate": "npm run db:generate --workspace=services/api",
    "deploy:vps:env": "node scripts/generate-vps-env.mjs",
    "deploy:vps": "node scripts/deploy-vps.mjs",
    "deploy:frontends": "node scripts/redeploy-frontends.mjs",
    "deploy:api": "node scripts/deploy-api-src.mjs",
    "deploy:learner-auth": "node scripts/deploy-learner-auth.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "smoke:mobile": "node scripts/smoke-mobile.mjs",
    "deploy:assetlinks": "node scripts/deploy-assetlinks.mjs",
    "test": "npm run test --workspace=services/api"
  },
  "engines": {
    "node": ">=22"
  }
}
