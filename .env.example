# Database
DATABASE_URL=postgresql://gotcha:gotcha_dev@localhost:5433/gotcha?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=gotcha
S3_SECRET_KEY=gotcha_dev_secret
S3_BUCKET=gotcha-content
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL_LOOKUP=gpt-4.1-mini
OPENAI_MODEL_QUIZ=gpt-4.1-mini

# API
API_PORT=3000
API_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Dev only — accept any email/password at login (never enable in production)
DEV_AUTH_ANY_CREDENTIAL=false

# Worker
WORKER_CONCURRENCY=5
