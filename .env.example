# Database
DATABASE_URL=postgresql://gotcha:gotcha_dev@localhost:5433/gotcha?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# S3 / MinIO (optional for PDF/EPUB blob durability; imports currently store files on local disk)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=gotcha
S3_SECRET_KEY=gotcha_dev_secret
S3_BUCKET=gotcha-content
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Local upload directory for PDF/EPUB imports (API + worker). Defaults to <cwd>/uploads
# UPLOADS_DIR=./uploads

# OpenAI — paste your key below (never commit real secrets). Restart the API after changing.
# Learner panel uses this for word lookup / quiz generation. Admin Settings / AI Usage control enablement, models, and quotas.
# Import pipeline also uses the same key to strip nav/ads/boilerplate from URL + PDF/EPUB imports (falls back to non-AI extract on failure).
OPENAI_API_KEY=
OPENAI_MODEL_LOOKUP=gpt-4.1-mini
OPENAI_MODEL_QUIZ=gpt-4.1-mini
OPENAI_MODEL_IMPORT=gpt-4.1-mini
# Set to false to disable AI import cleanup (deterministic Readability/PDF extract only).
IMPORT_AI_CLEANUP_ENABLED=true
# Optional override for Azure OpenAI or proxies:
# OPENAI_BASE_URL=

# API
API_PORT=3000
API_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Public learner URL used in verification email links
LEARNER_APP_URL=http://localhost:5175

# Telegram bot (Mini App auth). Leave the token blank locally; tests mock Telegram.
# On deploy, update.sh registers the webhook at https://<DOMAIN>/api/v1/telegram/webhook.
# The chat menu button stays off until the mini app exists. Phase 2 sets this to true.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_MINI_APP_URL=https://gotchaa.uz/learn/tg
# Learner production build (deploy/lib/vite-env.sh). Not a secret.
VITE_TELEGRAM_BOT_USERNAME=gotchaa_app
TELEGRAM_MENU_BUTTON_ENABLED=false
# Optional override. Deploy sets this to https://<DOMAIN>/api/v1/telegram/webhook
# TELEGRAM_WEBHOOK_URL=

# SMTP (Eskiz Mail for gotchaa.uz — SSL port 465). Leave blank locally to log links instead of sending.
# Create mailbox noreply@gotchaa.uz in the Eskiz mail panel (or use an existing mailbox on the domain).
SMTP_HOST=mail.gotchaa.uz
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@gotchaa.uz
SMTP_PASS=CHANGE_ME-mailbox-password
SMTP_FROM=GOTCHA <noreply@gotchaa.uz>
# SMTP_REPLY_TO=support@gotchaa.uz

# Dev only — accept any email/password at login (never enable in production)
DEV_AUTH_ANY_CREDENTIAL=false
# Import commerce quotas (paste / URL / PDF). Until a payment gateway is live, keep imports unlimited.
# IMPORTS_UNLIMITED=true forces unlimited. DEV_UNLIMITED_IMPORTS is the legacy alias.
# When PAYMENT_GATEWAY_ENABLED is false/absent, all users are treated as unlimited regardless of plan.
IMPORTS_UNLIMITED=true
DEV_UNLIMITED_IMPORTS=true
PAYMENT_GATEWAY_ENABLED=false

# Atmos Merchant API (never commit real secrets — use deploy/.env / local .env)
# Uses Merchant API flow (create → pre-apply → apply), NOT hosted checkout.
# Sandbox + production share apigw.atmos.uz; credentials determine environment.
# ATMOS_CONSUMER_KEY=
# ATMOS_CONSUMER_SECRET=
# ATMOS_STORE_ID=
# ATMOS_API_KEY=          # callback MD5 key from Atmos (optional in early sandbox)
# ATMOS_API_BASE=https://apigw.atmos.uz
# ATMOS_TERMINAL_ID=      # DO NOT SET — omit terminal_id on create; Atmos auto-selects the store terminal.
# ATMOS_LANG=ru
# ATMOS_IKPU=10899001001000000
# ATMOS_MIN_AMOUNT_SOM=500   # Atmos minimum charge per transaction (UZS / soʻm)
# ATMOS_MERCHANT_TIN=     # YaTT PINFL for OFD tin detail
# Callback URL to register with Atmos: https://YOUR_DOMAIN/api/v1/billing/atmos/webhook
# 
# Merchant API endpoints used:
#   POST /merchant/pay/create     - Create transaction
#   POST /merchant/pay/pre-apply  - Pre-confirm (sends OTP to cardholder)
#   POST /merchant/pay/apply      - Confirm with OTP
#   POST /merchant/pay/get        - Get transaction status
#   POST /merchant/pay/reverse    - Cancel/refund

# Worker
WORKER_CONCURRENCY=5

# --- Eskiz VPS2 (single-host full stack) — deploy only; never commit real values ---
# One VPS runs Postgres + Redis + MinIO + API + Worker + Marketing + Learner + Admin.
# Generate a filled deploy/.env with: node scripts/generate-vps-env.mjs
# Then deploy: node scripts/deploy-vps.mjs
# IP=
# PASSWORD=
# DOMAIN=
# DB_PASSWORD=
# VPS_APP_DIR=/var/www/gotcha
# Public URLs after deploy:
#   https://DOMAIN/          marketing
#   https://DOMAIN/learn/    learner
#   https://DOMAIN/admin/    admin
#   https://DOMAIN/api/v1    API


# Google Play Billing (Android in-app purchases) - see docs/PLAY-BILLING.md
PLAY_PACKAGE_NAME=app.gotcha.android
PLAY_SERVICE_ACCOUNT_JSON=
PLAY_RTDN_AUDIENCE=
PLAY_RTDN_SA_EMAIL=
# Deprecated: only used when PLAY_RTDN_AUDIENCE is empty
PLAY_RTDN_TOKEN=
PLAY_TOKEN_KEY=
PLAY_ACCOUNT_PEPPER=
