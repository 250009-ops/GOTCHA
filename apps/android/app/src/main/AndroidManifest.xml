<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
    </queries>

    <application
        android:name=".GotchaApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gotcha.Splash"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:documentLaunchMode="never"
            android:taskAffinity="${applicationId}"
            android:theme="@style/Theme.Gotcha.Splash"
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="gotchaa.uz" android:pathPrefix="/learn/verify-email" />
                <data android:scheme="https" android:host="gotchaa.uz" android:pathPrefix="/learn/reset-password" />
                <data android:scheme="https" android:host="gotchaa.uz" android:path="/verify-email" />
                <data android:scheme="https" android:host="gotchaa.uz" android:path="/reset-password" />
                <data android:scheme="https" android:host="www.gotchaa.uz" android:pathPrefix="/learn/verify-email" />
                <data android:scheme="https" android:host="www.gotchaa.uz" android:pathPrefix="/learn/reset-password" />
                <data android:scheme="https" android:host="www.gotchaa.uz" android:path="/verify-email" />
                <data android:scheme="https" android:host="www.gotchaa.uz" android:path="/reset-password" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="gotcha" android:host="verify-email" />
                <data android:scheme="gotcha" android:host="reset-password" />
            </intent-filter>
        </activity>
        <!-- Telegram / share targets hit this invisible forwarder — never a second MainActivity in recents. -->
        <activity
            android:name=".ImportTrampolineActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleTask"
            android:taskAffinity="${applicationId}"
            android:theme="@style/Theme.Gotcha.Trampoline">
            <intent-filter android:label="@string/open_with_gotcha">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <intent-filter android:label="@string/open_with_gotcha">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/epub+zip" />
            </intent-filter>
            <intent-filter android:label="@string/open_with_gotcha">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/epub" />
            </intent-filter>
            <intent-filter android:label="@string/open_with_gotcha">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <!-- B1 (lint AppLinkUrlError): file opens arrive as content:// URIs. -->
                <data android:scheme="content" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <intent-filter android:label="@string/open_with_gotcha">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <!-- B1 (lint AppLinkUrlError): file opens arrive as content:// URIs. -->
                <data android:scheme="content" />
                <data android:mimeType="application/epub+zip" />
            </intent-filter>
            <intent-filter android:label="@string/open_with_gotcha">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <!-- B1 (lint AppLinkUrlError): file opens arrive as content:// URIs. -->
                <data android:scheme="content" />
                <data android:mimeType="application/epub" />
            </intent-filter>
        </activity>
    </application>
</manifest>
