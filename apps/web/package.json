{
  "name": "@gotcha/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-legal.mjs",
    "preview": "vite preview",
    "legal:gen": "python3 scripts/gen_legal.py \"$LEGAL_DRAFTS_DIR\"",
    "check:legal": "node scripts/check-legal.mjs",
    "build:legal-qa": "VITE_LEGAL_V2=true vite build --outDir dist-legal-qa && node scripts/check-legal.mjs"
  },
  "dependencies": {
    "@gotcha/shared": "*",
    "@tailwindcss/vite": "^4.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}
