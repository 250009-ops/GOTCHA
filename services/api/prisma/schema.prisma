/// Where a purchase came from. Web = Atmos (gotchaa.uz), Android = Google Play Billing.
enum PurchaseSource {
  atmos
  google_play
  admin
}

enum StorePlatform {
  web
  google_play
}

/// What a SKU unlocks.
enum StoreProductKind {
  subscription
  import_tier
  catalog_book
}

enum EntitlementKind {
  plus
  catalog_book
  import_credit
}

enum EntitlementStatus {
  active
  expired
  revoked
}

/// Per-platform SKU → what it unlocks, with its own price (Play can carry Google's fee). Admin-editable.
model StoreProduct {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  platform     StorePlatform
  sku          String
  kind         StoreProductKind
  planTier     SubscriptionTier? @map("plan_tier")
  importTierId String?           @map("import_tier_id") @db.Uuid
  contentId    String?           @map("content_id") @db.Uuid
  /// Display/list price in UZS for this platform (Play's real price is set in Play Console).
  priceUzs     Int               @map("price_uzs")
  active       Boolean           @default(true)
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @default(now()) @updatedAt @map("updated_at")

  @@unique([platform, sku])
  @@index([kind, contentId])
  @@map("store_products")
}

/// Unified ledger: every paid unlock from any source. Access tables (user_subscriptions,
/// content_purchases, import_payments) are projections of active rows.
model Entitlement {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String            @map("user_id") @db.Uuid
  kind            EntitlementKind
  source          PurchaseSource
  /// Atmos import_payments.id, Play purchaseToken hash, or admin grant id. One entitlement per (source, ref, kind).
  sourceRef       String            @map("source_ref")
  sku             String?
  contentId       String?           @map("content_id") @db.Uuid
  importPaymentId String?           @map("import_payment_id") @db.Uuid
  status          EntitlementStatus @default(active)
  startsAt        DateTime          @default(now()) @map("starts_at")
  expiresAt       DateTime?         @map("expires_at")
  revokedReason   String?           @map("revoked_reason")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict) // WLF-13: payment records are never deleted with the user

  @@unique([source, sourceRef, kind])
  @@index([userId, status])
  @@map("entitlements")
}

/// Google Play purchase as last verified with the Play Developer API (never trusted from the client).
model PlayPurchase {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// sha256(purchaseToken): tokens are long and secret-ish; we only need equality.
  tokenHash     String           @unique @map("token_hash")
  purchaseToken String           @map("purchase_token")
  userId        String           @map("user_id") @db.Uuid
  sku           String
  kind          StoreProductKind
  orderId       String?          @map("order_id")
  /// Play state: purchased | pending | canceled | expired | on_hold | paused | revoked | refunded
  state         String
  acknowledged  Boolean          @default(false)
  consumed      Boolean          @default(false)
  expiryTime    DateTime?        @map("expiry_time")
  autoRenewing  Boolean?         @map("auto_renewing")
  raw           Json?
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict) // WLF-13: payment records are never deleted with the user

  @@index([userId])
  @@index([orderId])
  @@map("play_purchases")
}

// P3b: report & block (Play UGC policy). Blocks are symmetric in effect: neither side can message
// or discover the other. Reports land in a review queue (status=open); no auto-action.
enum UserReportReason {
  spam
  harassment
  inappropriate
  underage
  other
}

enum UserReportStatus {
  open
  reviewed
  actioned
  dismissed
}

model UserBlock {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

model UserReport {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// WL4-11: null once the reporter / reported user deletes their account (report kept for safety, anonymised).
  reporterId      String?          @map("reporter_id") @db.Uuid
  reportedUserId  String?          @map("reported_user_id") @db.Uuid
  conversationId  String?          @map("conversation_id") @db.Uuid
  messageId       String?          @map("message_id") @db.Uuid
  reason          UserReportReason
  details         String?
  messageSnapshot String?          @map("message_snapshot")
  status          UserReportStatus @default(open)
  createdAt       DateTime         @default(now()) @map("created_at")
  reviewedAt      DateTime?        @map("reviewed_at")

  reporter     User? @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: SetNull)
  reportedUser User? @relation("ReportsReceived", fields: [reportedUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reportedUserId])
  @@unique([reporterId, messageId])
  @@map("user_reports")
}

enum AgeRating {
  all_ages
  teen_13
  mature_18
}

model ContentGloss {
  id           String      @id @default(uuid()) @db.Uuid
  contentId    String      @map("content_id") @db.Uuid
  chapterIndex Int         @default(0) @map("chapter_index")
  word         String
  uz           String?
  ru           String?
  sortOrder    Int         @default(0) @map("sort_order")
  createdAt    DateTime    @default(now()) @map("created_at")
  content      ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, word])
  @@index([contentId, chapterIndex])
  @@map("content_glosses")
}

model ComprehensionQuestion {
  id           String      @id @default(uuid()) @db.Uuid
  contentId    String      @map("content_id") @db.Uuid
  chapterIndex Int         @default(0) @map("chapter_index")
  question     String
  answer       String
  /// PM question type, e.g. short_answer | multiple_choice (free text, validated by the importer).
  type         String      @default("short_answer")
  /// MCQ options, stored as the full set incl. the answer; served shuffled. Empty = open question.
  options      String[]    @default([])
  sortOrder    Int         @default(0) @map("sort_order")
  createdAt    DateTime    @default(now()) @map("created_at")
  content      ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, sortOrder])
  @@index([contentId, chapterIndex])
  @@map("comprehension_questions")
}

enum FriendRequestStatus {
  pending
  accepted
  declined
}

enum ContentReportStatus {
  open
  reviewed
  actioned
  dismissed
}

model FriendRequest {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requesterId String              @map("requester_id") @db.Uuid
  addresseeId String              @map("addressee_id") @db.Uuid
  status      FriendRequestStatus @default(pending)
  createdAt   DateTime            @default(now()) @map("created_at")
  respondedAt DateTime?           @map("responded_at")

  requester User @relation("FriendRequestsSent", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendRequestsReceived", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@map("friend_requests")
}

model ContentReport {
  id         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId String?             @map("reporter_id") @db.Uuid
  contentId  String?             @map("content_id") @db.Uuid
  importId   String?             @map("import_id") @db.Uuid
  reason     UserReportReason
  details    String?
  status     ContentReportStatus @default(open)
  createdAt  DateTime            @default(now()) @map("created_at")
  reviewedAt DateTime?           @map("reviewed_at")

  reporter User? @relation(fields: [reporterId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("content_reports")
}

/// Durable Postgres-backed import queue (claimed with FOR UPDATE SKIP LOCKED by the worker process).
model ImportQueueJob {
  id           String    @id @default(uuid()) @db.Uuid
  userImportId String    @unique @map("user_import_id") @db.Uuid
  kind         String    /// file | url | paste
  status       String    @default("queued") /// queued | running | done | failed
  attempts     Int       @default(0)
  maxAttempts  Int       @default(3) @map("max_attempts")
  runAfter     DateTime  @default(now()) @map("run_after")
  lockedBy     String?   @map("locked_by")
  lockedAt     DateTime? @map("locked_at")
  heartbeatAt  DateTime? @map("heartbeat_at")
  lastError    String?   @map("last_error")
  payload      Json
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")
  finishedAt   DateTime? @map("finished_at")

  userImport UserImport @relation(fields: [userImportId], references: [id], onDelete: Cascade)

  @@index([status, runAfter])
  @@index([status, heartbeatAt])
  @@map("import_queue_jobs")
}

/// Stored upload from /imports/inspect so /imports/file does not need the bytes again.
model ImportUpload {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  fileKey      String     @map("file_key")
  originalName String     @map("original_name")
  mimeType     String     @map("mime_type")
  sizeBytes    Int        @map("size_bytes")
  sha256       String
  importType   ImportType @map("import_type")
  pageCount    Int        @map("page_count")
  createdAt    DateTime   @default(now()) @map("created_at")
  expiresAt    DateTime   @map("expires_at")
  consumedAt   DateTime?  @map("consumed_at")

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("import_uploads")
}

/// Questions prepared for one reader page. Served by Mashq; not the on-click chapter quiz.
model PageQuestion {
  id            String   @id @default(uuid()) @db.Uuid
  segmentId     String   @map("segment_id") @db.Uuid
  contentId     String   @map("content_id") @db.Uuid
  segmentHash   String   @map("segment_hash")
  promptI18n    Json     @map("prompt_i18n")
  optionsI18n   Json     @map("options_i18n")
  answerIndex   Int      @map("answer_index")
  evidenceStart Int      @default(0) @map("evidence_start")
  evidenceEnd   Int      @default(0) @map("evidence_end")
  evidenceQuote String   @map("evidence_quote")
  explanationI18n Json   @map("explanation_i18n")
  status        String   @default("active")
  timesServed   Int      @default(0) @map("times_served")
  timesCorrect  Int      @default(0) @map("times_correct")
  createdAt     DateTime @default(now()) @map("created_at")

  segment  ContentSegment       @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  seen     PageQuestionSeen[]
  served   PracticeQuestion[]

  @@index([segmentId, status])
  @@index([contentId, status])
  @@map("page_questions")
}

model PageQuestionSeen {
  userId     String   @map("user_id") @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  correct    Boolean?
  seenAt     DateTime @default(now()) @map("seen_at")

  question PageQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([userId, questionId])
  @@index([userId, seenAt])
  @@map("page_question_seen")
}

enum TelegramChallengeKind {
  code
  link
}

enum TelegramChallengeStatus {
  pending
  approved
  denied
  expired
  used
}

/// Website phone login, password reset, and "continue in the bot" confirmation.
model TelegramLoginChallenge {
  id         String                  @id @default(uuid()) @db.Uuid
  userId     String?                 @map("user_id") @db.Uuid
  kind       TelegramChallengeKind
  /// login | reset
  purpose    String                  @default("login")
  codeHash   String?                 @map("code_hash")
  token      String?                 @unique
  status     TelegramChallengeStatus @default(pending)
  attempts   Int                     @default(0)
  userAgent  String?                 @map("user_agent")
  ip         String?
  expiresAt  DateTime                @map("expires_at")
  lastSentAt DateTime?               @map("last_sent_at")
  createdAt  DateTime                @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, expiresAt])
  @@map("telegram_login_challenges")
}

/// Telegram user who has not finished mini-app sign-up. The bot writes the shared phone here.
model TelegramPendingSignup {
  telegramId    BigInt    @id @map("telegram_id")
  phone         String?
  phoneSharedAt DateTime? @map("phone_shared_at")
  firstName     String    @default("") @map("first_name")
  lastName      String    @default("") @map("last_name")
  username      String?
  /// Bot language chosen in Telegram. New rows stay uz until the person taps the keyboard.
  locale        String    @default("uz")
  /// sha256 of the 6-digit mini-app sign-up code. Cleared after a successful register.
  codeHash      String?   @map("code_hash")
  codeExpiresAt DateTime? @map("code_expires_at")
  codeAttempts  Int       @default(0) @map("code_attempts")
  codeSentAt    DateTime? @map("code_sent_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("telegram_pending_signups")
}

/// Notification pushes through the bot, for the 3-a-day limit. Auth codes are not logged here.
model TelegramOutboundLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  kind      String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("telegram_outbound_log")
}
