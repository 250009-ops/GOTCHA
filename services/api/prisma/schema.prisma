/**
 * Direct (1:1) learner conversation. Pair key is sorted participant user ids.
 */
model Conversation {
  id            String       @id @default(uuid()) @db.Uuid
  pairKey       String       @unique @map("pair_key")
  language      AppLanguage?
  contentId     String?      @map("content_id") @db.Uuid
  lastMessageAt DateTime?    @map("last_message_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  content      ContentItem?              @relation(fields: [contentId], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([lastMessageAt])
  @@map("conversations")
}

model ConversationParticipant {
  conversationId String    @map("conversation_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  lastReadAt        DateTime? @map("last_read_at")
  /// Last message this participant has actually seen. Unread is counted after this row, not after a clock time.
  lastReadMessageId String?   @map("last_read_message_id") @db.Uuid
  typingUntil       DateTime? @map("typing_until")
  joinedAt          DateTime  @default(now()) @map("joined_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  senderId       String?      @map("sender_id") @db.Uuid
  body           String
  translation    String?
  bodyLang       AppLanguage? @map("body_lang")
  replyToId      String?      @map("reply_to_id") @db.Uuid
  editedAt       DateTime?    @map("edited_at")
  deletedAt      DateTime?    @map("deleted_at")
  /// First body, kept after edit or delete so admins can still read a reported message.
  originalBody   String?      @map("original_body")
  createdAt      DateTime     @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?        @relation(fields: [senderId], references: [id], onDelete: SetNull) // final-5 WL4-11 B: hard delete keeps messages as "Deleted user"
  replyTo      Message?     @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]    @relation("MessageReply")
  edits        MessageEdit[]

  @@index([conversationId, createdAt])
  @@index([replyToId])
  @@map("messages")
}

/// Prior bodies of an edited message. Learners never see this; Safety reports do.
model MessageEdit {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, createdAt])
  @@map("message_edits")
}

