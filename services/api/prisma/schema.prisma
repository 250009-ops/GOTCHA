/** Direct (1:1) learner conversation. Pair key is sorted participant user ids. */
model Conversation {
  id            String       @id @default(uuid()) @db.Uuid
  pairKey       String       @unique @map("pair_key")
  language      AppLanguage?
  contentId     String?      @map("content_id") @db.Uuid
  lastMessageAt DateTime?    @map("last_message_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  content      ContentItem?              @relation(fields: [contentId], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([lastMessageAt])
  @@map("conversations")
}

model ConversationParticipant {
  conversationId String    @map("conversation_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  lastReadAt     DateTime? @map("last_read_at")
  joinedAt       DateTime  @default(now()) @map("joined_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  senderId       String       @map("sender_id") @db.Uuid
  body           String
  translation    String?
  bodyLang       AppLanguage? @map("body_lang")
  replyToId      String?      @map("reply_to_id") @db.Uuid
  editedAt       DateTime?    @map("edited_at")
  deletedAt      DateTime?    @map("deleted_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo      Message?     @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]    @relation("MessageReply")

  @@index([conversationId, createdAt])
  @@index([replyToId])
  @@map("messages")
}

/// Items issued by GET /practice/daily. POST /practice/answer only grades an issued (vocabId, type).
model PracticeSessionItem {
  id         String    @id @default(uuid()) @db.Uuid
  sessionId  String    @map("session_id") @db.Uuid
  vocabId    String    @map("vocab_id") @db.Uuid
  type       String
  extra      Boolean   @default(false)
  attempts   Int       @default(0)
  /// Set when the last answer was wrong ("again"): one more attempt is allowed in this session.
  requeue    Boolean   @default(false)
  answeredAt DateTime? @map("answered_at")

  session PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, vocabId, type])
  @@map("practice_session_items")
}

/// Admin-managed promo codes. Applied at checkout to Atmos payments; redeemed when the payment is paid.
model PromoCode {
  id             String    @id @default(uuid()) @db.Uuid
  /// Uppercase, A-Z 0-9 _ -.
  code           String    @unique
  description    String?
  /// Exactly one of percentOff (1–70) / amountOffUzs is set.
  percentOff     Int?      @map("percent_off")
  amountOffUzs   Int?      @map("amount_off_uzs")
  /// imports | catalog | all
  appliesTo      String    @default("all") @map("applies_to")
  validFrom      DateTime? @map("valid_from")
  validTo        DateTime? @map("valid_to")
  maxRedemptions Int?      @map("max_redemptions")
  redemptions    Int       @default(0)
  perUserLimit   Int       @default(1) @map("per_user_limit")
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("promo_codes")
}

/// Where a purchase came from. Web = Atmos (gotchaa.uz), Android = Google Play Billing.
enum PurchaseSource {
  atmos
  google_play
  admin
}

enum StorePlatform {
  web
  google_play
}

/// What a SKU unlocks.
enum StoreProductKind {
  subscription
  import_tier
  catalog_book
}

enum EntitlementKind {
  plus
  catalog_book
  import_credit
}

enum EntitlementStatus {
  active
  expired
  revoked
}

/// Per-platform SKU → what it unlocks, with its own price (Play can carry Google's fee). Admin-editable.
model StoreProduct {
  id           String           @id @default(uuid()) @db.Uuid
  platform     StorePlatform
  sku          String
  kind         StoreProductKind
  planTier     SubscriptionTier? @map("plan_tier")
  importTierId String?          @map("import_tier_id") @db.Uuid
  contentId    String?          @map("content_id") @db.Uuid
  /// Display/list price in UZS for this platform (Play's real price is set in Play Console).
  priceUzs     Int              @map("price_uzs")
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@unique([platform, sku])
  @@index([kind, contentId])
  @@map("store_products")
}

/// Unified ledger: every paid unlock from any source. Access tables (user_subscriptions,
/// content_purchases, import_payments) are projections of active rows.
model Entitlement {
  id         String            @id @default(uuid()) @db.Uuid
  userId     String            @map("user_id") @db.Uuid
  kind       EntitlementKind
  source     PurchaseSource
  /// Atmos import_payments.id, Play purchaseToken hash, or admin grant id. One entitlement per (source, ref, kind).
  sourceRef  String            @map("source_ref")
  sku        String?
  contentId  String?           @map("content_id") @db.Uuid
  importPaymentId String?      @map("import_payment_id") @db.Uuid
  status     EntitlementStatus @default(active)
  startsAt   DateTime          @default(now()) @map("starts_at")
  expiresAt  DateTime?         @map("expires_at")
  revokedReason String?        @map("revoked_reason")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([source, sourceRef, kind])
  @@index([userId, status])
  @@map("entitlements")
}

/// Google Play purchase as last verified with the Play Developer API (never trusted from the client).
model PlayPurchase {
  id             String   @id @default(uuid()) @db.Uuid
  /// sha256(purchaseToken): tokens are long and secret-ish; we only need equality.
  tokenHash      String   @unique @map("token_hash")
  purchaseToken  String   @map("purchase_token")
  userId         String   @map("user_id") @db.Uuid
  sku            String
  kind           StoreProductKind
  orderId        String?  @map("order_id")
  /// Play state: purchased | pending | canceled | expired | on_hold | paused | revoked | refunded
  state          String
  acknowledged   Boolean  @default(false)
  consumed       Boolean  @default(false)
  expiryTime     DateTime? @map("expiry_time")
  autoRenewing   Boolean?  @map("auto_renewing")
  raw            Json?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([orderId])
  @@map("play_purchases")
}
